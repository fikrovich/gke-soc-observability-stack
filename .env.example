# GCP / Terraform
PROJECT_ID=example-observability
REGION=example-region-1
CLUSTER_NAME=observability-cluster
NETWORK_NAME=platform-net
SUBNET_NAME=platform-subnet
SUBNET_CIDR=10.10.0.0/16
MASTER_IPV4_CIDR=172.16.0.0/28
AUTHORIZED_NETWORKS_JSON=[{"display_name":"office","cidr_block":"203.0.113.10/32"}]

# Image registry / tags
IMAGE_REGISTRY=ghcr.io/example/gke-soc-observability-stack
EDGE_INGEST_API_IMAGE=ghcr.io/example/gke-soc-observability-stack/edge-ingest:kafka-ack-20260222044602
EDGE_INGEST_WORKER_IMAGE=ghcr.io/example/gke-soc-observability-stack/edge-ingest:kafka-ack-commitfix-20260222064658
INVESTIGATION_OPS_IMAGE=ghcr.io/example/gke-soc-observability-stack/investigation-ops:20260314-210422

# Edge ingest secret values
EDGE_INGEST_AUTH_TOKEN=replace-me
EDGE_INGEST_ES_PASSWORD=replace-me

# Grafana admin secret values
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

# Monitoring / exporter
ES_EXPORTER_URI=https://elastic:replace-me@search-stack-es-http.observability.svc.cluster.local:9200

# Security investigations secret values
INVESTIGATION_WEBHOOK_SHARED_TOKEN=replace-me
INVESTIGATION_ELASTICSEARCH_USERNAME=elastic
INVESTIGATION_ELASTICSEARCH_PASSWORD=replace-me
INVESTIGATION_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
INVESTIGATION_GRAFANA_WEBHOOK_BEARER=replace-me
GRAFANA_PRIMARY_ALERTS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
GRAFANA_INVESTIGATION_ALERTS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me

# Grafana bootstrap runtime vars
ELASTICSEARCH_URL=https://search-stack-es-http.observability.svc.cluster.local:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace-me
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=replace-me

# Kafka bootstrap runtime vars
KAFKA_NAMESPACE=kafka
KAFKA_BOOTSTRAP_SERVER=kafka.kafka.svc.cluster.local:9092

# Optional namespace and resource overrides
GRAFANA_NAMESPACE=grafana
SEARCH_NAMESPACE=observability
SEARCH_CLUSTER_NAME=search-stack
SEARCH_UI_NAME=kibana
INVESTIGATION_NAMESPACE=investigations
