# GCP / Terraform
PROJECT_ID=example-observability
REGION=example-region-1
CLUSTER_NAME=observability-cluster
CLUSTER_DELETION_PROTECTION=false
NETWORK_NAME=platform-net
SUBNET_NAME=platform-subnet
SUBNET_CIDR=10.10.0.0/16
MASTER_IPV4_CIDR=172.16.0.0/28
AUTHORIZED_NETWORKS_JSON=[{"display_name":"office","cidr_block":"203.0.113.10/32"}]
ROUTER_NAME=platform-router
NAT_NAME=platform-nat
MASTER_NODE_COUNT=1
MASTER_MACHINE_TYPE=n2d-standard-2
MASTER_DISK_SIZE_GB=50
MASTER_DISK_TYPE=pd-standard
HOT_MIN_NODE_COUNT=1
HOT_MAX_NODE_COUNT=1
HOT_MACHINE_TYPE=e2-standard-4
HOT_DISK_SIZE_GB=80
HOT_DISK_TYPE=pd-standard
WARM_MIN_NODE_COUNT=1
WARM_MAX_NODE_COUNT=1
WARM_MACHINE_TYPE=e2-standard-4
WARM_DISK_SIZE_GB=80
WARM_DISK_TYPE=pd-standard
WORKLOAD_MIN_NODE_COUNT=1
WORKLOAD_MAX_NODE_COUNT=2
WORKLOAD_MACHINE_TYPE=e2-standard-4
WORKLOAD_DISK_SIZE_GB=80
WORKLOAD_DISK_TYPE=pd-standard

# Image registry / tags
IMAGE_REGISTRY=ghcr.io/example/gke-soc-observability-stack
EDGE_INGEST_API_IMAGE=ghcr.io/example/gke-soc-observability-stack/edge-ingest:kafka-ack-20260222044602
EDGE_INGEST_WORKER_IMAGE=ghcr.io/example/gke-soc-observability-stack/edge-ingest:kafka-ack-commitfix-20260222064658
INVESTIGATION_OPS_IMAGE=ghcr.io/example/gke-soc-observability-stack/investigation-ops:20260314-210422

# Edge ingest secret values
EDGE_INGEST_AUTH_TOKEN=replace-me
EDGE_INGEST_ES_PASSWORD=replace-me

# Grafana admin secret values
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

# Monitoring / exporter
ES_EXPORTER_URI=https://elastic:replace-me@search-stack-es-http.observability.svc.cluster.local:9200

# Security investigations secret values
INVESTIGATION_WEBHOOK_SHARED_TOKEN=replace-me
INVESTIGATION_ELASTICSEARCH_USERNAME=elastic
INVESTIGATION_ELASTICSEARCH_PASSWORD=replace-me
INVESTIGATION_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
INVESTIGATION_GRAFANA_WEBHOOK_BEARER=replace-me
GRAFANA_PRIMARY_ALERTS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me
GRAFANA_INVESTIGATION_ALERTS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/me

# Grafana bootstrap runtime vars
ELASTICSEARCH_URL=https://search-stack-es-http.observability.svc.cluster.local:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace-me
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=replace-me

# Kafka bootstrap runtime vars
KAFKA_NAMESPACE=kafka
KAFKA_BOOTSTRAP_SERVER=kafka.kafka.svc.cluster.local:9092

# Optional namespace and resource overrides
GRAFANA_NAMESPACE=grafana
SEARCH_NAMESPACE=observability
SEARCH_CLUSTER_NAME=search-stack
SEARCH_UI_NAME=kibana
INVESTIGATION_NAMESPACE=investigations
ELASTICSEARCH_VERSION=8.19.8
ELASTICSEARCH_PORT_FORWARD=true
GRAFANA_PORT_FORWARD=true
GRAFANA_SERVICE_TYPE=ClusterIP
GRAFANA_STORAGE_CLASS=standard-rwo
GRAFANA_STORAGE=5Gi
GRAFANA_CPU_REQUEST=100m
GRAFANA_MEMORY_REQUEST=128Mi
GRAFANA_CPU_LIMIT=500m
GRAFANA_MEMORY_LIMIT=512Mi
KIBANA_COUNT=1
KIBANA_SERVICE_TYPE=ClusterIP
KIBANA_CPU_REQUEST=250m
KIBANA_MEMORY_REQUEST=512Mi
KIBANA_CPU_LIMIT=500m
KIBANA_MEMORY_LIMIT=1Gi
ES_MASTER_COUNT=1
ES_MASTER_JAVA_OPTS=-Xms1g -Xmx1g
ES_MASTER_CPU_REQUEST=500m
ES_MASTER_MEMORY_REQUEST=2Gi
ES_MASTER_CPU_LIMIT=1
ES_MASTER_MEMORY_LIMIT=2Gi
ES_HOT_COUNT=1
ES_HOT_STORAGE_CLASS=standard-rwo
ES_HOT_STORAGE=80Gi
ES_HOT_JAVA_OPTS=-Xms2g -Xmx2g
ES_HOT_CPU_REQUEST=1
ES_HOT_MEMORY_REQUEST=4Gi
ES_HOT_CPU_LIMIT=2
ES_HOT_MEMORY_LIMIT=4Gi
ES_WARM_COUNT=1
ES_WARM_STORAGE_CLASS=standard-rwo
ES_WARM_STORAGE=80Gi
ES_WARM_JAVA_OPTS=-Xms2g -Xmx2g
ES_WARM_CPU_REQUEST=500m
ES_WARM_MEMORY_REQUEST=4Gi
ES_WARM_CPU_LIMIT=1
ES_WARM_MEMORY_LIMIT=4Gi
KAFKA_CONTROLLER_REPLICAS=1
KAFKA_CONTROLLER_ONLY=false
KAFKA_CONTROLLER_STORAGE_CLASS=standard-rwo
KAFKA_CONTROLLER_STORAGE=8Gi
KAFKA_CONTROLLER_CPU_REQUEST=250m
KAFKA_CONTROLLER_MEMORY_REQUEST=512Mi
KAFKA_CONTROLLER_CPU_LIMIT=1
KAFKA_CONTROLLER_MEMORY_LIMIT=1Gi
KAFKA_BROKER_REPLICAS=1
KAFKA_BROKER_STORAGE_CLASS=standard-rwo
KAFKA_BROKER_STORAGE=20Gi
KAFKA_BROKER_CPU_REQUEST=500m
KAFKA_BROKER_MEMORY_REQUEST=1Gi
KAFKA_BROKER_CPU_LIMIT=1
KAFKA_BROKER_MEMORY_LIMIT=2Gi
EDGE_INGEST_API_REPLICAS=1
EDGE_INGEST_WORKER_REPLICAS=1
INVESTIGATION_API_REPLICAS=1
INVESTIGATION_WORKER_REPLICAS=1
EDGE_INGEST_SERVICE_TYPE=ClusterIP
