        "model": {
          "editorMode": "code",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=~\".*edge.*|.*investigation.*\"})",
          "intervalMs": 1000,
          "legendFormat": "lag",
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
