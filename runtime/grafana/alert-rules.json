[
  {
    "uid": "platform-ingest-lag-high",
    "orgID": 1,
    "folderUID": "platform-signals",
    "ruleGroup": "platform-signals",
    "title": "Ingest Queue Lag High",
    "condition": "B",
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
