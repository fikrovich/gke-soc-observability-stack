        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [10000],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A"]
              },
              "reducer": {
                "params": [],
                "type": "last"
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "B",
          "type": "threshold"
        }
      }
    ],
    "noDataState": "OK",
    "execErrState": "Alerting",
    "for": "5m",
    "keep_firing_for": "0s",
    "annotations": {
      "summary": "Consumer lag stayed above the public example threshold for five minutes.",
      "description": "Use this sample rule as a starting point for queue lag alerting. Tune the metric selector, threshold, and routing for your own environment.",
      "runbook": "Check queue backlog, consumer health, and downstream indexing throughput before scaling consumers or changing write settings."
    },
    "labels": {
      "category": "platform-reliability",
      "severity": "warning"
    },
    "isPaused": false
  },
